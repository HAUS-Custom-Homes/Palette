# Copy to .env and fill in. .env is gitignored and never committed (house rule).
# Every value here is entered by Trevor, never by an agent.

# ---- Database ---------------------------------------------------------------
# Unset: PGlite (real Postgres, in-process, under ./data/pg). No install needed.
# Set:   hosted Postgres (Neon, Vercel Postgres, Supabase). Run `npm run migrate` once.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Storage (FR-11, FR-13) ---------------------------------------------------
# local: filesystem under QUARRY_DATA_DIR. r2: Cloudflare R2, private bucket.
QUARRY_STORE_DRIVER=local
QUARRY_DATA_DIR=./data
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=quarry

# ---- Sign-in ------------------------------------------------------------------
# Google OAuth client (Web application). Authorised redirect URI:
#   https://YOUR-HOST/api/auth/callback/google  (and http://localhost:3200/... for dev)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Random 32+ bytes: `openssl rand -base64 32`. Required in production.
# AUTH_SECRET=
QUARRY_ALLOWED_DOMAIN=hauscustomhomes.com
# Development only: a sign-in box that takes any email, so the app is usable
# before Google is configured. Ignored in production no matter what.
QUARRY_DEV_AUTH=1

# ---- Background tagging on Vercel -------------------------------------------
# Vercel sends this on cron calls. Any random string; set the same in Vercel.
# CRON_SECRET=

# ---- AI tagging (FR-17) -------------------------------------------------------
# Without this the heuristic tagger runs (filenames only, low confidence).
# ANTHROPIC_API_KEY=
QUARRY_TAG_MODEL=claude-opus-5
